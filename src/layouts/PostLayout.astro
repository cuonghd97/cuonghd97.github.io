---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  tags: string[];
}

const { title, description, pubDate, tags } = Astro.props;

// Estimate reading time (~200 words per minute)
const rawContent = await Astro.slots.render('default');
const wordCount = rawContent.replace(/<[^>]*>/g, '').split(/\s+/).length;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));

const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={`${title} — cuonghd97`} description={description}>
  <article>
    <!-- Post header -->
    <header class="mb-10 border-b border-gray-800/60 pb-10">
      <div class="mb-4 flex flex-wrap items-center gap-3 text-sm text-gray-400">
        <time datetime={pubDate.toISOString()} class="flex items-center gap-1.5">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
          </svg>
          {formattedDate}
        </time>
        <span class="text-gray-600">·</span>
        <span class="flex items-center gap-1.5">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
          </svg>
          {readingTime} min read
        </span>
      </div>

      <h1
        class="mb-4 text-3xl font-extrabold leading-tight tracking-tight text-white sm:text-4xl lg:text-5xl"
      >
        {title}
      </h1>

      <p class="text-lg text-gray-400">{description}</p>

      {tags.length > 0 && (
        <div class="mt-5 flex flex-wrap gap-2">
          {tags.map((tag) => (
            <a
              href={`/blog?tag=${tag}`}
              class="rounded-full bg-emerald-500/10 px-3 py-1 text-xs font-medium text-emerald-400 ring-1 ring-emerald-500/20 transition-all duration-300 hover:bg-emerald-500/20 hover:ring-emerald-500/40"
            >
              #{tag}
            </a>
          ))}
        </div>
      )}
    </header>

    <!-- Post body -->
    <div
      class="prose prose-invert lg:prose-xl max-w-none prose-headings:text-emerald-400 prose-code:text-cyan-300 prose-a:text-emerald-400 prose-a:no-underline hover:prose-a:underline prose-pre:bg-gray-900 prose-pre:border prose-pre:border-gray-800 prose-img:rounded-lg prose-blockquote:border-emerald-500/40"
    >
      <slot />
    </div>

    <!-- Back to blog -->
    <div class="mt-16 border-t border-gray-800/60 pt-8">
      <a
        href="/blog"
        class="group inline-flex items-center gap-2 text-sm font-medium text-gray-400 transition-all duration-300 hover:text-emerald-400"
      >
        <svg
          class="h-4 w-4 transition-transform duration-300 group-hover:-translate-x-1"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
        Back to all posts
      </a>
    </div>
  </article>
</BaseLayout>
