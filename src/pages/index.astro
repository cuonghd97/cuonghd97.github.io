---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

// Fetch latest 3 blog posts
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const latestPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

// Featured projects data
const projects = [
  {
    name: 'cuonghd97.github.io',
    description: 'Personal portfolio and tech blog built with Astro, Tailwind CSS, and deployed on GitHub Pages.',
    stack: ['Astro', 'Tailwind CSS', 'TypeScript'],
    url: 'https://github.com/cuonghd97/cuonghd97.github.io',
  },
  {
    name: 'Local AI Stack',
    description: 'Self-hosted AI infrastructure with Ollama, Open WebUI, and custom model orchestration for local development.',
    stack: ['Python', 'Docker', 'Ollama', 'FastAPI'],
    url: 'https://github.com/cuonghd97',
  },
  {
    name: 'Microservices Template',
    description: 'Production-ready microservices boilerplate with Spring Boot, gRPC communication, and observability stack.',
    stack: ['Java', 'Spring Boot', 'gRPC', 'Docker'],
    url: 'https://github.com/cuonghd97',
  },
  {
    name: 'DevOps Toolkit',
    description: 'Collection of automation scripts, CI/CD pipelines, and infrastructure-as-code templates for rapid deployment.',
    stack: ['Bash', 'GitHub Actions', 'Terraform', 'Ansible'],
    url: 'https://github.com/cuonghd97',
  },
  {
    name: 'PyQt5 Desktop App',
    description: 'Cross-platform desktop application with modern UI, built with Python and PyQt5 for internal tooling.',
    stack: ['Python', 'PyQt5', 'SQLite'],
    url: 'https://github.com/cuonghd97',
  },
  {
    name: 'System Monitor',
    description: 'Lightweight system monitoring dashboard with real-time metrics, alerts, and historical data visualization.',
    stack: ['Go', 'Prometheus', 'Grafana', 'Docker'],
    url: 'https://github.com/cuonghd97',
  },
];
---

<BaseLayout title="cuonghd97 — Backend & Systems Engineer">
  <!-- Hero Section -->
  <section class="pb-20 pt-8">
    <div class="flex flex-col gap-6">
      <!-- Terminal-like greeting -->
      <div class="inline-flex items-center gap-2 text-sm font-mono text-emerald-400">
        <span class="inline-block h-3 w-3 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>~/cuonghd97 <span class="text-gray-500">$</span> whoami</span>
      </div>

      <h1 class="text-4xl font-extrabold leading-tight tracking-tight text-white sm:text-5xl lg:text-6xl">
        Hi, I'm a <br />
        <span class="bg-gradient-to-r from-emerald-400 via-cyan-400 to-teal-400 bg-clip-text text-transparent">
          Backend &amp; Systems Engineer
        </span>
      </h1>

      <p class="max-w-2xl text-lg leading-relaxed text-gray-400">
        I design and build scalable backend systems, containerized infrastructures,
        and developer tooling. My core stack includes
        <span class="font-medium text-gray-300">Java</span>,
        <span class="font-medium text-gray-300">Python</span>,
        <span class="font-medium text-gray-300">Docker</span>, and
        <span class="font-medium text-gray-300">System Architecture</span>.
        Lately, I've been exploring
        <span class="font-medium text-gray-300">local AI</span> workflows and
        self-hosted infrastructure.
      </p>

      <!-- CTA buttons -->
      <div class="flex flex-wrap gap-4 pt-2">
        <a
          href="/blog"
          class="group inline-flex items-center gap-2 rounded-lg bg-emerald-500 px-5 py-2.5 text-sm font-semibold text-gray-950 shadow-lg shadow-emerald-500/20 transition-all duration-300 hover:bg-emerald-400 hover:shadow-emerald-500/30 hover:-translate-y-0.5"
        >
          Read my Blog
          <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
          </svg>
        </a>
        <a
          href="https://github.com/cuonghd97"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-lg border border-gray-700 bg-gray-900/50 px-5 py-2.5 text-sm font-semibold text-gray-300 transition-all duration-300 hover:border-gray-600 hover:bg-gray-800/50 hover:text-white hover:-translate-y-0.5"
        >
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"></path></svg>
          GitHub
        </a>
        <a
          href="https://linkedin.com/in/cuonghd97"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-lg border border-gray-700 bg-gray-900/50 px-5 py-2.5 text-sm font-semibold text-gray-300 transition-all duration-300 hover:border-gray-600 hover:bg-gray-800/50 hover:text-white hover:-translate-y-0.5"
        >
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path></svg>
          LinkedIn
        </a>
      </div>
    </div>
  </section>

  <!-- Featured Projects Section -->
  <section class="pb-20">
    <div class="mb-8 flex items-center gap-3">
      <h2 class="text-2xl font-bold text-white">Featured Projects</h2>
      <div class="h-px flex-1 bg-gradient-to-r from-gray-800 to-transparent"></div>
    </div>

    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {projects.map((project) => (
        <a
          href={project.url}
          target="_blank"
          rel="noopener noreferrer"
          class="group relative flex flex-col rounded-xl border border-gray-800/80 bg-gray-900/40 p-5 transition-all duration-300 hover:border-emerald-500/30 hover:bg-gray-900/70 hover:shadow-lg hover:shadow-emerald-500/5 hover:-translate-y-1"
        >
          <div class="mb-3 flex items-center gap-2 text-emerald-400">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"></path>
            </svg>
            <h3 class="font-semibold text-white group-hover:text-emerald-400 transition-colors duration-300">{project.name}</h3>
          </div>
          <p class="mb-4 flex-1 text-sm leading-relaxed text-gray-400">{project.description}</p>
          <div class="flex flex-wrap gap-1.5">
            {project.stack.map((tech) => (
              <span class="rounded-md bg-gray-800/80 px-2 py-0.5 text-xs font-medium text-cyan-300">{tech}</span>
            ))}
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Latest Blog Posts Section -->
  <section class="pb-12">
    <div class="mb-8 flex items-center gap-3">
      <h2 class="text-2xl font-bold text-white">Latest Posts</h2>
      <div class="h-px flex-1 bg-gradient-to-r from-gray-800 to-transparent"></div>
    </div>

    {latestPosts.length > 0 ? (
      <div class="flex flex-col gap-4">
        {latestPosts.map((post) => (
          <a
            href={`/blog/${post.id}`}
            class="group flex flex-col gap-2 rounded-xl border border-gray-800/80 bg-gray-900/40 p-5 transition-all duration-300 hover:border-emerald-500/30 hover:bg-gray-900/70 hover:-translate-y-0.5 sm:flex-row sm:items-center sm:gap-6"
          >
            <time
              datetime={post.data.pubDate.toISOString()}
              class="shrink-0 font-mono text-sm text-gray-500"
            >
              {post.data.pubDate.toISOString().slice(0, 10)}
            </time>
            <div class="flex-1">
              <h3 class="font-semibold text-white transition-colors duration-300 group-hover:text-emerald-400">
                {post.data.title}
              </h3>
              <p class="mt-1 text-sm text-gray-400 line-clamp-1">{post.data.description}</p>
            </div>
            <svg
              class="hidden h-5 w-5 shrink-0 text-gray-600 transition-all duration-300 group-hover:text-emerald-400 group-hover:translate-x-1 sm:block"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </a>
        ))}
      </div>
    ) : (
      <p class="text-gray-500">No posts yet. Stay tuned!</p>
    )}

    <div class="mt-8 text-center">
      <a
        href="/blog"
        class="inline-flex items-center gap-2 text-sm font-medium text-gray-400 transition-all duration-300 hover:text-emerald-400"
      >
        View all posts
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
        </svg>
      </a>
    </div>
  </section>
</BaseLayout>
