---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Collect all unique tags
const allTags = [...new Set(sortedPosts.flatMap((post) => post.data.tags))].sort();

// Get active tag from URL
const activeTag = Astro.url.searchParams.get('tag');

// Filter posts by tag if one is selected
const filteredPosts = activeTag
  ? sortedPosts.filter((post) => post.data.tags.includes(activeTag))
  : sortedPosts;
---

<BaseLayout title="Blog — cuonghd97" description="Articles about backend engineering, DevOps, system design, and local AI.">
  <section>
    <!-- Header -->
    <div class="mb-10">
      <h1 class="text-3xl font-extrabold tracking-tight text-white sm:text-4xl">Blog</h1>
      <p class="mt-2 text-gray-400">
        Thoughts on backend engineering, DevOps, system design, and developer tooling.
      </p>
    </div>

    <!-- Tag filter -->
    {allTags.length > 0 && (
      <div class="mb-8 flex flex-wrap items-center gap-2">
        <a
          href="/blog"
          class:list={[
            'rounded-full px-3 py-1 text-xs font-medium transition-all duration-300',
            !activeTag
              ? 'bg-emerald-500/20 text-emerald-400 ring-1 ring-emerald-500/40'
              : 'bg-gray-800/60 text-gray-400 ring-1 ring-gray-700/60 hover:bg-gray-800 hover:text-gray-300',
          ]}
        >
          All
        </a>
        {allTags.map((tag) => (
          <a
            href={`/blog?tag=${tag}`}
            class:list={[
              'rounded-full px-3 py-1 text-xs font-medium transition-all duration-300',
              activeTag === tag
                ? 'bg-emerald-500/20 text-emerald-400 ring-1 ring-emerald-500/40'
                : 'bg-gray-800/60 text-gray-400 ring-1 ring-gray-700/60 hover:bg-gray-800 hover:text-gray-300',
            ]}
          >
            #{tag}
          </a>
        ))}
      </div>
    )}

    <!-- Posts list -->
    {filteredPosts.length > 0 ? (
      <div class="flex flex-col gap-4">
        {filteredPosts.map((post) => (
          <a
            href={`/blog/${post.id}`}
            class="group flex flex-col gap-3 rounded-xl border border-gray-800/80 bg-gray-900/40 p-6 transition-all duration-300 hover:border-emerald-500/30 hover:bg-gray-900/70 hover:-translate-y-0.5"
          >
            <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:gap-6">
              <time
                datetime={post.data.pubDate.toISOString()}
                class="shrink-0 font-mono text-sm text-gray-500"
              >
                {post.data.pubDate.toISOString().slice(0, 10)}
              </time>
              <div class="flex-1">
                <h2 class="text-lg font-semibold text-white transition-colors duration-300 group-hover:text-emerald-400">
                  {post.data.title}
                </h2>
                <p class="mt-1 text-sm leading-relaxed text-gray-400 line-clamp-2">
                  {post.data.description}
                </p>
                {post.data.tags.length > 0 && (
                  <div class="mt-3 flex flex-wrap gap-1.5">
                    {post.data.tags.map((tag) => (
                      <span class="rounded-md bg-gray-800/80 px-2 py-0.5 text-xs font-medium text-cyan-300">
                        #{tag}
                      </span>
                    ))}
                  </div>
                )}
              </div>
              <svg
                class="hidden h-5 w-5 shrink-0 text-gray-600 transition-all duration-300 group-hover:text-emerald-400 group-hover:translate-x-1 sm:block mt-1"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <div class="rounded-xl border border-gray-800/80 bg-gray-900/40 p-12 text-center">
        <p class="text-gray-500">
          {activeTag ? `No posts found with tag #${activeTag}.` : 'No posts yet. Stay tuned!'}
        </p>
      </div>
    )}
  </section>
</BaseLayout>
